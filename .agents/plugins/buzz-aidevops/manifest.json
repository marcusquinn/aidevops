{
  "id": "sh.aidevops.buzz",
  "name": "aidevops",
  "apiVersion": 1,
  "description": "Shows this computer's aidevops Buzz setup in Settings and adds an aidevops agent type that runs aidevops OpenCode agents on this computer.",
  "discovery": { "category": "developer-tools", "tags": ["aidevops", "setup", "agents", "opencode"] },
  "host": {
    "commands": [
      {
        "id": "buzz-status",
        "program": "aidevops",
        "args": ["buzz", "status"],
        "maxOutputBytes": 16384
      }
    ],
    "processes": [
      {
        "id": "acp",
        "program": "aidevops",
        "args": ["buzz", "acp"]
      }
    ],
    "mcp": true,
    "files": true
  }
}
