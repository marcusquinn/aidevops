{
  "id": "sh.aidevops.buzz",
  "name": "aidevops",
  "apiVersion": 1,
  "description": "Shows this computer's aidevops Buzz setup status in Settings.",
  "discovery": { "category": "developer-tools", "tags": ["aidevops", "setup"] },
  "host": {
    "commands": [
      {
        "id": "buzz-status",
        "program": "aidevops",
        "args": ["buzz", "status"],
        "maxOutputBytes": 16384
      }
    ]
  }
}
