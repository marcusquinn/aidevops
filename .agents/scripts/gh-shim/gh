#
# PATH shim for scripted gh calls (t19095). Strips the agent-detection variables
# (AIDEVOPS_GH_AGENT_ENV_VARS, defined in shared-constants.sh) from the gh child
# only, so gh >= 2.105.0 does not emit agent-only hints into captured output.
# Prepended to PATH by shared-constants.sh; execs the next real gh on PATH.

_shim_dir="$(cd "${BASH_SOURCE[0]%/*}" 2>/dev/null && pwd)" || _shim_dir=""
_filtered=""
_old_ifs="$IFS"
IFS=":"
for _entry in $PATH; do
	[[ -n "$_entry" ]] || continue
	_abs="$(cd "$_entry" 2>/dev/null && pwd)" || _abs="$_entry"
	[[ "$_abs" == "$_shim_dir" ]] && continue
	_filtered="${_filtered:+${_filtered}:}${_entry}"
done
IFS="$_old_ifs"

_real_gh="$(PATH="$_filtered" command -v gh)" || {
	printf 'gh: command not found\n' >&2
	exit 127
}

_unset_args=()
for _var in ${AIDEVOPS_GH_AGENT_ENV_VARS:-AI_AGENT AGENT CODEX_SANDBOX CODEX_CI CODEX_THREAD_ID GEMINI_CLI COPILOT_CLI OPENCODE ANTIGRAVITY_AGENT AUGMENT_AGENT CLAUDE_CODE_IS_COWORK CLAUDECODE CLAUDE_CODE CURSOR_TRACE_ID CURSOR_AGENT CURSOR_EXTENSION_HOST_ROLE GOOSE_PROVIDER}; do
	_unset_args+=("-u" "$_var")
done

PATH="$_filtered" exec env "${_unset_args[@]}" "$_real_gh" "$@"
