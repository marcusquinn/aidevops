#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2025-2026 Marcus Quinn

set -u

# Directory of a path by parameter expansion: no dirname fork per shimmed Git call.
shim_dirname() {
	local path="$1"
	case "$path" in
	*/*) path="${path%/*}" ;;
	*) path="." ;;
	esac
	printf '%s' "${path:-/}"
	return 0
}

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
if [[ -L "$SCRIPT_SOURCE" ]]; then
	# One readlink spawn for the whole symlink chain; hop loop below is the fallback.
	SCRIPT_RESOLVED=$(command -p readlink -f -- "$SCRIPT_SOURCE" 2>/dev/null) || SCRIPT_RESOLVED=""
	[[ "$SCRIPT_RESOLVED" == /* && -f "$SCRIPT_RESOLVED" ]] && SCRIPT_SOURCE="$SCRIPT_RESOLVED"
fi
while [[ -L "$SCRIPT_SOURCE" ]]; do
	SCRIPT_LINK_DIR="$(cd "$(shim_dirname "$SCRIPT_SOURCE")" && pwd)" || exit 1
	SCRIPT_SOURCE=$(readlink "$SCRIPT_SOURCE") || exit 1
	[[ "$SCRIPT_SOURCE" == /* ]] || SCRIPT_SOURCE="${SCRIPT_LINK_DIR}/${SCRIPT_SOURCE}"
done
SCRIPT_DIR="$(cd "$(shim_dirname "$SCRIPT_SOURCE")" && pwd)" || exit 1
GUARD="${SCRIPT_DIR}/canonical-git-command-guard.py"
REENTRY_SENTINEL="AIDEVOPS_CANONICAL_GIT_GUARD_ACTIVE"

if [[ "${!REENTRY_SENTINEL:-}" == "1" ]]; then
	printf 'BLOCKED: recursive aidevops Git shim invocation\n' >&2
	exit 126
fi

# shellcheck source=runtime-env.sh
AIDEVOPS_RUNTIME_ENV_LIBRARY_ONLY=1 source "${SCRIPT_DIR}/runtime-env.sh" || exit 126

REAL_GIT=$(aidevops_resolve_native_git "$SCRIPT_SOURCE") || {
	printf 'BLOCKED: canonical Git guard could not resolve the real git binary\n' >&2
	exit 127
}

if [[ ! -f "$GUARD" ]] || ! command -v python3 >/dev/null 2>&1; then
	printf 'BLOCKED: canonical Git policy engine is unavailable\n' >&2
	exit 126
fi
export AIDEVOPS_CANONICAL_GIT_GUARD_ACTIVE=1
python3 "$GUARD" --cwd "$PWD" --real-git "$REAL_GIT" -- "$@" || exit $?
unset AIDEVOPS_CANONICAL_GIT_GUARD_ACTIVE

exec "$REAL_GIT" "$@"
